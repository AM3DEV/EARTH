{
  "expo": {
    "name": "Jordan Tourism Guide",
    "slug": "erth-project",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "jordanguide",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jordanguide.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to show nearby monuments, events and businesses on the map.",
        "NSPhotoLibraryUsageDescription": "We need photo access to let you upload a profile picture and review images."
      },
      "config": {
        "googleMapsApiKey": ""
      }
    },
    "android": {
      "package": "com.jordanguide.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Jordan Guide to use your location to find nearby experiences."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Jordan Guide to access photos for profile and uploads."
        }
      ],
      "expo-system-ui"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4447dd39-3d91-46c1-bbf3-6df6c94df635"
      }
    },
    "owner": "am3.wav",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4447dd39-3d91-46c1-bbf3-6df6c94df635"
    }
  }
}
